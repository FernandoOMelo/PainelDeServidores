{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Painel de Servidores",
  "version": "1.0.0",
  "identifier": "br.com.fernandomeelo.paineldeservidores",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "principal",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": false,
      "tooltip": "Painel de Servidores",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
